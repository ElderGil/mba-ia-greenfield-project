# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
# The test suites use <DB_NAME>_test (created and migrated by Jest globalSetup).
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
# Host used to sign the multipart part URLs (PUT) handed to clients.
# Empty = S3_ENDPOINT (minio:9000), which only resolves inside the Compose
# network; keep it empty to run the test suites. For manual uploads from the
# host (curl/browser), set http://localhost:9000.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
# The test suites use <S3_BUCKET>-test.
S3_BUCKET=streamtube-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Queue (Redis / BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
# Client side only: the compose redis has no password. Setting one here also
# requires configuring the server (requirepass), or every connection fails.
REDIS_PASSWORD=
# BullMQ key prefix (default bull). The test suites force their own
# (src/test/test-env.ts), so they never touch the worker's jobs.
QUEUE_PREFIX=bull

# Video Upload & Processing
VIDEO_MAX_SIZE_BYTES=10737418240
VIDEO_UPLOAD_PART_SIZE_BYTES=10485760
VIDEO_PRESIGNED_URL_EXPIRES_IN=900
# Open (not completed) uploads allowed per channel
VIDEO_MAX_OPEN_DRAFTS=5
# Worker maintenance sweep (every 15 min): drafts older than this are aborted
# and removed; processing videos idle this long without a live job are failed
VIDEO_DRAFT_TTL_HOURS=24
VIDEO_PROCESSING_STUCK_MINUTES=30
