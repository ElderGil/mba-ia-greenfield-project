      "get": {
        "description": "Streams a ready video via 206 Partial Content for a single byte range on GET, or 200 OK otherwise. Conditionals are evaluated first (RFC 9110): a matching If-None-Match answers 304, an If-Range that is not the current ETag gets the full file. HEAD, unknown range units and multiple ranges get the full representation.",
        "operationId": "VideosController_streamVideo",
        "parameters": [
          {
            "name": "shortCode",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Range",
            "in": "header",
            "description": "Serve the range only if the ETag still matches; otherwise the full file",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "Single byte range (e.g., bytes=0-1048575)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full video byte stream"
          },
          "206": {
            "description": "Partial video byte stream"
          },
          "304": {
            "description": "Not modified (If-None-Match matched the ETag)"
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "Invalid or unsatisfiable byte range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream video content with HTTP Byte-Range support",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{shortCode}/download": {
      "get": {
        "description": "Streams the full video file with Content-Disposition: attachment.",
        "operationId": "VideosController_downloadVideo",
        "parameters": [
          {
            "name": "shortCode",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Video file download stream"
          },
          "304": {
            "description": "Not modified (If-None-Match matched the ETag)"
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Download video file as attachment",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{shortCode}/thumbnail": {
      "get": {
        "description": "Streams the JPEG thumbnail extracted from the video frame during background processing.",
        "operationId": "VideosController_getThumbnail",
        "parameters": [
          {
            "name": "shortCode",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JPEG thumbnail image"
          },
          "304": {
            "description": "Not modified (If-None-Match matched the ETag)"
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get generated JPEG thumbnail for a ready video",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "My Awesome Video",
            "maxLength": 255
          },
          "filename": {
            "type": "string",
            "example": "recording.mp4",
            "maxLength": 255
          },
          "mimeType": {
            "type": "string",
            "example": "video/mp4",
            "enum": [
              "video/mp4",
              "video/webm",
              "video/quicktime",
              "video/x-matroska"
            ]
          },
          "sizeBytes": {
            "type": "number",
            "example": 104857600,
            "description": "File size in bytes (up to 10 GiB = 10737418240 bytes)"
          }
        },
        "required": [
          "title",
          "filename",
          "mimeType",
          "sizeBytes"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "shortCode": {
            "type": "string",
            "example": "aB3dE6gH9jK"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "draft"
          },
          "uploadId": {
            "type": "string"
          },
          "storageKey": {
            "type": "string"
          },
          "partSizeBytes": {
            "type": "number",
            "example": 10485760
          },
          "maxParts": {
            "type": "number",
            "example": 10000
          }
        },
        "required": [
          "videoId",
          "shortCode",
          "status",
          "uploadId",
          "storageKey",
          "partSizeBytes",
          "maxParts"
        ]
      },
      "SignUploadPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "partNumber"
        ]
      },
      "SignUploadPartResponseDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "presignedUrl": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 900
          }
        },
        "required": [
          "partNumber",
          "presignedUrl",
          "expiresInSeconds"
        ]
      },
      "UploadedPartResponseDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "\"d41d8cd98f00b204e9800998ecf8427e\""
          },
          "sizeBytes": {
            "type": "number",
            "example": 10485760
          }
        },
        "required": [
          "partNumber",
          "etag",
          "sizeBytes"
        ]
      },
      "ListUploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartResponseDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "UploadPartEtagDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "maximum": 10000
          },
          "etag": {
            "type": "string",
            "example": "\"d41d8cd98f00b204e9800998ecf8427e\""
          }
        },
        "required": [
          "partNumber",
          "etag"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadPartEtagDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "shortCode": {
            "type": "string",
            "example": "aB3dE6gH9jK"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "processing"
          },
          "jobId": {
            "type": "string",
            "example": "process-video-uuid"
          }
        },
        "required": [
          "videoId",
          "shortCode",
          "status",
          "jobId"
        ]
      },
      "VideoOwnerResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "channelId": {
            "type": "string",
            "format": "uuid"
          },
          "shortCode": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "originalFilename": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ]
          },
          "mimeType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true
          },
          "width": {
            "type": "integer",
            "nullable": true
          },
          "height": {
            "type": "integer",
            "nullable": true
          },
          "codec": {
            "type": "string",
            "nullable": true
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "Public thumbnail URL once the video is ready"
          },
          "processingError": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "channelId",
          "shortCode",
          "title",
          "originalFilename",
          "status",
          "mimeType",
          "sizeBytes",
          "durationSeconds",
          "width",
          "height",
          "codec",
          "thumbnailUrl",
          "processingError",
          "createdAt",
          "updatedAt"
        ]
      },
      "VideoPublicResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "shortCode": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ]
          },
          "mimeType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true
          },
          "width": {
            "type": "integer",
            "nullable": true
          },
          "height": {
            "type": "integer",
            "nullable": true
          },
          "codec": {
            "type": "string",
            "nullable": true
          },
          "streamUrl": {
            "type": "string"
          },
          "downloadUrl": {
            "type": "string"
          },
          "thumbnailUrl": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "shortCode",
          "title",
          "status",
          "mimeType",
          "sizeBytes",
          "durationSeconds",
          "width",
          "height",
          "codec",
          "streamUrl",
          "downloadUrl",
          "thumbnailUrl",
          "createdAt"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}